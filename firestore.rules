rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles & login credentials
    match /users/{userId} {
      allow read, write: if true;
    }

    // Individual capstone projects (proposals) & nested milestones
    match /proposals/{proposalId} {
      allow read, write: if true;

      match /milestones/{milestoneId} {
        allow read, write: if true;
      }
    }

    // Project archive & historical thesis repository
    match /project_archive/{projectId} {
      allow read, write: if true;
    }

    match /historical_theses/{thesisId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
